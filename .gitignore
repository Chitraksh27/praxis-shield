# Root ignores for Praxis Shield (Python backend + Next.js frontend)

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and secrets
.env
.env.*
!.env.example
backend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Python backend
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
backend/venv/
backend/.venv/

# Dataset / model artifacts (large local files)
*.gguf
*.bin
*.safetensors
backend/unsloth_medical_dataset.jsonl
backend/*.gguf

# Frontend / Node
node_modules/
frontend/node_modules/
frontend/.next/
out/
frontend/out/
.next/

# Build / cache
dist/
build/
.cache/
coverage/

# TypeScript
*.tsbuildinfo
